{
  "name": "whiteboard-tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @whiteboard/server\" \"npm run dev -w @whiteboard/web\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/board-core/test/*.test.ts apps/server/test/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run build -w @whiteboard/web && npm run build -w @whiteboard/server",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
